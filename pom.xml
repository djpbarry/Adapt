<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>45.1.0</version>
        <relativePath/>
    </parent>

    <groupId>net.calm</groupId>
    <artifactId>adapt</artifactId>
    <version>4.0.5</version>

    <name>net.calm.adapt</name>
    <description>Maven implementation of net.calm.adapt.Adapt plugin.</description>
    <url>https://github.com/djpbarry/net.calm.adapt.Adapt</url>
    <inceptionYear>2015</inceptionYear>
    <organization>
        <name>David Barry</name>
        <url>https://github.com/djpbarry</url>
    </organization>
    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>djpbarry</id>
            <name>David Barry</name>
            <url>https://forum.image.sc/u/djpbarry</url>
            <roles>
                <role>lead</role>
                <role>developer</role>
                <role>debugger</role>
                <role>reviewer</role>
                <role>support</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>David Barry</name>
            <roles>
                <role>founder</role>
            </roles>
            <properties>
                <id>djpbarry</id>
            </properties>
        </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>Image.sc Forum</name>
            <archive>https://forum.image.sc/tags/adapt</archive>
        </mailingList>
    </mailingLists>

    <scm>
        <connection>scm:git:git://github.com/djpbarry/net.calm.adapt.Adapt</connection>
        <developerConnection>scm:git:git@github.com:djpbarry/net.calm.adapt.Adapt</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/github.com/djpbarry/net.calm.adapt.Adapt</url>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/djpbarry/net.calm.adapt.Adapt/issues</url>
    </issueManagement>
    <ciManagement>
        <system>None</system>
    </ciManagement>

    <properties>
        <package-name>net.calm.adapt</package-name>
        <main-class>net.calm.adapt.adapt.Main</main-class>
        <license.licenseName>gpl_v3</license.licenseName>
        <license.copyrightOwners>David Barry</license.copyrightOwners>
        <scijava.jvm.version>21</scijava.jvm.version>
    </properties>

    <repositories>
        <!-- NB: declare Central first so JitPack cannot shadow it with empty files -->
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
        <!-- NB: for SciJava dependencies -->
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
        Core dependencies resolved from JitPack (auth-free).

        * IAClassLibrary `2.0.22` - modernised (Java 21, GPL-3.0); API docs at
          https://djpbarry.github.io/IAClassLibrary/
        * TrackerLibrary `v4.0.8` - modernised (Java 21, GPL-3.0); API docs at
          https://djpbarry.github.io/TrackerLibrary/
        -->
        <dependency>
            <groupId>com.github.djpbarry</groupId>
            <artifactId>IAClassLibrary</artifactId>
            <version>2.0.22</version>
        </dependency>
        <dependency>
            <groupId>com.github.djpbarry</groupId>
            <artifactId>TrackerLibrary</artifactId>
            <version>v4.0.8</version>
        </dependency>
        <!-- JSON parsing (Decision 5: params.json) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Test framework (JUnit 5, version managed by pom-scijava parent) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>